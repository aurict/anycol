{
  "name": "anycol",
  "private": true,
  "packageManager": "bun@1.3.12",
  "overrides": {
    "nanoid": "3.3.18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run build:api && bun run build:worker && bun run build:web && bun run build:admin",
    "build:web": "bun run --cwd apps/web build",
    "build:admin": "bun run --cwd apps/admin build",
    "build:api": "bun run --cwd apps/api build",
    "build:worker": "bun run --cwd apps/worker build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test:coverage && bun run build",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:migrate": "bun packages/db/src/migrate.ts",
    "workspace:provision": "bun scripts/provision-workspace.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^11.2.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "bullmq": "^6.0.8",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.2",
    "ioredis": "^5.7.0",
    "jose": "^6.1.2",
    "next": "^16.3.0",
    "pg": "^8.16.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.0"
  }
}
