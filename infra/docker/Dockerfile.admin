FROM oven/bun:1.3.14-alpine AS deps
WORKDIR /app
COPY package.json bun.lock tsconfig.json ./
COPY apps apps
COPY packages packages
RUN bun install --frozen-lockfile

FROM node:24-alpine AS build
WORKDIR /app
COPY --from=deps /app ./
RUN cd apps/admin && node ../../node_modules/next/dist/bin/next build

FROM gcr.io/distroless/nodejs24-debian13:nonroot@sha256:fbbdda866ea71aef98c4abece17e3d61fbf820cc2ef3961522caa2478716171a
WORKDIR /app
COPY --from=build /app/apps/admin/.next/standalone ./
COPY --from=build /app/apps/admin/.next/static ./apps/admin/.next/static
ENV NODE_ENV=production PORT=3001 HOSTNAME=0.0.0.0
EXPOSE 3001
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 CMD ["/nodejs/bin/node", "-e", "fetch('http://127.0.0.1:3001/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["apps/admin/server.js"]
