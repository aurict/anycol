FROM oven/bun:1.3.14-alpine AS build
WORKDIR /app
COPY package.json bun.lock tsconfig.json ./
COPY apps apps
COPY packages packages
RUN bun install --frozen-lockfile
RUN bun run build:api

FROM gcr.io/distroless/nodejs24-debian13:nonroot@sha256:fbbdda866ea71aef98c4abece17e3d61fbf820cc2ef3961522caa2478716171a
WORKDIR /app
COPY --from=build /app/apps/api/dist/server.js ./server.js
ENV NODE_ENV=production
EXPOSE 4000
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 CMD ["/nodejs/bin/node", "-e", "fetch('http://127.0.0.1:4000/ready').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["server.js"]
